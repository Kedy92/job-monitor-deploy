APP_NAME=Job Monitor
ENV=dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jobmonitor
SECRET_KEY=change-this-in-production
SCHEDULER_INTERVAL_MINUTES=5
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://www.jobmonitor.online"]
BACKEND_CORS_ORIGIN_REGEX=^https://((www\.)?jobmonitor\.online|.*\.vercel\.app)$
ANTHROPIC_API_KEY=
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
FROM_EMAIL=notifications@example.com
APP_BASE_URL=http://localhost:8000
